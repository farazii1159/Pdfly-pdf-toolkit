# ─────────────────────────────────────────────────────────
# Supabase configuration
# Get these from: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────

# Project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "public" key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key — SERVER ONLY. Never expose this in the browser
# or commit it to GitHub. Used only inside API route handlers.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────
# App configuration
# ─────────────────────────────────────────────────────────

# Max upload size in MB (default: 10)
MAX_FILE_SIZE_MB=10
